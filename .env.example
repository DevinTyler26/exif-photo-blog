# Copy to .env, fill secrets, and restrict it with chmod 600.
# Images are built for the Debian host's x86_64 architecture on the Mac,
# loaded into Docker on that host, then started with Compose.
POSTGRES_IMAGE=postgres:16.14-bookworm
REDIS_IMAGE=redis:7.4.2-alpine
WEB_IMAGE_TAG=local
APP_DATA_ROOT=./data
APP_UID=1001
APP_GID=1001

# Cloudflare Tunnel route photo.devincunningham.com -> 192.168.4.177:3100.
WEB_BIND_ADDRESS=192.168.4.177
WEB_HOST_PORT=3100

# PostgreSQL administrator is only used for initialization and restore work.
# Use URL-safe hex passwords for both PostgreSQL roles.
POSTGRES_DB=exif_photo_blog
POSTGRES_USER=photo_blog_admin
POSTGRES_PASSWORD=CHANGE_ME_URL_SAFE_HEX
APP_DB_USER=photo_blog_app
APP_DB_PASSWORD=CHANGE_ME_URL_SAFE_HEX
DISABLE_POSTGRES_SSL=1

# Redis accepts connections only on the private Compose network and requires a password.
# Use a unique URL-safe hex value so it can be embedded in REDIS_URL safely.
REDIS_PASSWORD=CHANGE_ME_URL_SAFE_HEX
NEXT_IMAGE_CACHE_MAX_BYTES=2147483648

# Auth secrets stay runtime-only and are never passed as Docker build arguments.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=CHANGE_ME
AUTH_SECRET=CHANGE_ME_GENERATE_A_LONG_RANDOM_SECRET
AUTH_URL=https://photo.devincunningham.com
AUTH_TRUST_HOST=

# Strict local-only mode suppresses AI, Google Places, and configured external scripts.
EXIF_LOCAL_ONLY=1
DISABLE_AUTO_GENERATE_LOCATIONS=1
DISABLE_DEBUG_OUTPUTS=1

# MinIO's public host and bucket must match the existing objects and stored URLs.
NEXT_PUBLIC_DOMAIN="photo.devincunningham.com"
NEXT_PUBLIC_STORAGE_PREFERENCE="minio"
NEXT_PUBLIC_MINIO_DOMAIN="minio.devincunningham.com"
NEXT_PUBLIC_MINIO_BUCKET="project-photo"
NEXT_PUBLIC_MINIO_PORT=
MINIO_ACCESS_KEY=CHANGE_ME
MINIO_SECRET_ACCESS_KEY=CHANGE_ME

# These public settings preserve the existing presentation configuration.
# All static-generation switches are on; build against the supplied/restored
# staging snapshot, never the only production database. All NEXT_PUBLIC_* values
# are compiled into the image. Unlisted optional values retain app defaults.
NEXT_PUBLIC_META_TITLE="Project Photo"
NEXT_PUBLIC_META_DESCRIPTION=
NEXT_PUBLIC_NAV_TITLE=
NEXT_PUBLIC_NAV_CAPTION="A yearlong journey of daily photography—365 photos, 365 days."
NEXT_PUBLIC_SIDEBAR_TEXT=
NEXT_PUBLIC_CATEGORY_VISIBILITY="cameras,lenses,tags,albums,years,focal-lengths"
NEXT_PUBLIC_SOCIAL_NETWORKS="all"
NEXT_PUBLIC_SITE_FEEDS=1
NEXT_PUBLIC_LOCALE=en-us
NEXT_PUBLIC_DEFAULT_THEME=system
NEXT_PUBLIC_GRID_HOMEPAGE="1"
NEXT_PUBLIC_DEFAULT_SORT=
NEXT_PUBLIC_NAV_SORT_CONTROL=
NEXT_PUBLIC_DOMAIN_SHARE=
NEXT_PUBLIC_IMAGE_QUALITY="100"
NEXT_PUBLIC_PRESERVE_ORIGINAL_UPLOADS="1"
NEXT_PUBLIC_STATICALLY_OPTIMIZE_PHOTOS="1"
NEXT_PUBLIC_STATICALLY_OPTIMIZE_PAGES="1"
NEXT_PUBLIC_STATICALLY_OPTIMIZE_PHOTO_OG_IMAGES="1"
NEXT_PUBLIC_STATICALLY_OPTIMIZE_OG_IMAGES="1"
NEXT_PUBLIC_STATICALLY_OPTIMIZE_PHOTO_CATEGORIES="1"
NEXT_PUBLIC_STATICALLY_OPTIMIZE_PHOTO_CATEGORY_OG_IMAGES="1"

# Additional optional public presentation flags. Values are public and baked
# into the image during Compose builds.
NEXT_PUBLIC_ALLOW_PUBLIC_DOWNLOADS="1"
NEXT_PUBLIC_ALWAYS_SHOW_EXPOSURE_COMP=
NEXT_PUBLIC_AWS_S3_BUCKET=
NEXT_PUBLIC_AWS_S3_REGION=
NEXT_PUBLIC_BLUR_DISABLED=
NEXT_PUBLIC_CLOUDFLARE_R2_ACCOUNT_ID=
NEXT_PUBLIC_CLOUDFLARE_R2_BUCKET=
NEXT_PUBLIC_CLOUDFLARE_R2_PUBLIC_DOMAIN=
NEXT_PUBLIC_COLOR_SORT=
NEXT_PUBLIC_COLOR_SORT_CHROMA_CUTOFF=
NEXT_PUBLIC_COLOR_SORT_STARTING_HUE=
NEXT_PUBLIC_DISABLE_BLUR="1"
NEXT_PUBLIC_DISABLE_UPPERCASE_TITLES=
NEXT_PUBLIC_EXHAUSTIVE_SIDEBAR_CATEGORIES=
NEXT_PUBLIC_GEO_PRIVACY=
NEXT_PUBLIC_GRID_ASPECT_RATIO=
NEXT_PUBLIC_HIDE_CATEGORIES_ON_MOBILE=
NEXT_PUBLIC_HIDE_CATEGORY_IMAGE_HOVERS=
NEXT_PUBLIC_HIDE_EXIF_DATA=
NEXT_PUBLIC_HIDE_KEYBOARD_SHORTCUT_TOOLTIPS=
NEXT_PUBLIC_HIDE_SOCIAL=
NEXT_PUBLIC_HIDE_TAGS_WITH_ONE_PHOTO=
NEXT_PUBLIC_HIDE_TAKEN_AT_TIME=
NEXT_PUBLIC_HIDE_TEMPLATE_ATTRIBUTION=
NEXT_PUBLIC_HIDE_ZOOM_CONTROLS=
NEXT_PUBLIC_HIGH_DENSITY_PREVIEWS=
NEXT_PUBLIC_MASONRY_GRID=
NEXT_PUBLIC_MATTE_COLOR=
NEXT_PUBLIC_MATTE_COLOR_DARK=
NEXT_PUBLIC_MATTE_PHOTOS=
NEXT_PUBLIC_MINIO_DISABLE_SSL="0"
NEXT_PUBLIC_OG_TEXT_ALIGNMENT=
NEXT_PUBLIC_PAGE_ABOUT="This challenge is about celebrating creativity, consistency, and the beauty of everyday moments."
NEXT_PUBLIC_PRIORITY_BASED_SORTING=
NEXT_PUBLIC_PRO_MODE=
NEXT_PUBLIC_SHOW_LARGE_THUMBNAILS="1"
NEXT_PUBLIC_SITE_ABOUT=
NEXT_PUBLIC_SITE_DESCRIPTION=
NEXT_PUBLIC_SITE_DOMAIN=
NEXT_PUBLIC_SITE_TITLE=
NEXT_PUBLIC_TINT_FOLDERS=
